APP_ENV=development
APP_NAME=Global Remote Job Tool API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://jobtool:jobtool@localhost:5432/jobtool
CORS_ORIGINS=["http://localhost:3000"]
GREENHOUSE_REQUEST_TIMEOUT_SECONDS=15
GREENHOUSE_MAX_RETRIES=3
SOURCE_CIRCUIT_BREAKER_THRESHOLD=3
SOURCE_CIRCUIT_BREAKER_COOLDOWN_MINUTES=30
REFRESH_SOURCE_CONCURRENCY=3
REFRESH_SOURCE_TIMEOUT_SECONDS=600
REFRESH_STALE_AFTER_SECONDS=900
INTERNAL_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PIP_INDEX_URL=https://pypi.org/simple
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
